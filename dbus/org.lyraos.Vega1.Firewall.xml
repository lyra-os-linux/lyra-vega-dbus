<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/org/lyraos/Vega1">
  <interface name="org.lyraos.Vega1.Firewall">
    <!-- FirewallServiceInfo struct: (name, label, enabled) -->

    <method name="Status">
      <!-- polkit: none (read-only) -->
      <arg name="enabled" type="b" direction="out"/>
      <arg name="activeZone" type="s" direction="out"/>
    </method>

    <method name="ListServices">
      <!-- polkit: none (read-only) -->
      <arg name="services" type="a(ssb)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;FirewallService&gt;"/>
    </method>

    <method name="SetServiceEnabled">
      <!-- polkit: org.lyraos.vega.firewall.configure -->
      <arg name="name" type="s" direction="in"/>
      <arg name="enabled" type="b" direction="in"/>
    </method>

    <!-- FirewallPortInfo struct: (port, protocol) — port is either a single
         number ("8080") or a range ("9000-9010"); protocol is "tcp" or "udp" -->

    <method name="ListPorts">
      <!-- polkit: none (read-only) -->
      <arg name="ports" type="a(ss)" direction="out"/>
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QList&lt;FirewallPortInfo&gt;"/>
    </method>

    <method name="AddPort">
      <!-- polkit: org.lyraos.vega.firewall.configure -->
      <arg name="port" type="s" direction="in"/>
      <arg name="protocol" type="s" direction="in"/>
    </method>

    <method name="RemovePort">
      <!-- polkit: org.lyraos.vega.firewall.configure -->
      <arg name="port" type="s" direction="in"/>
      <arg name="protocol" type="s" direction="in"/>
    </method>

    <!-- What listens on the network and whether the firewall lets it in
         (capability "network-exposure-v1"; lyra-ecosystem openspec change
         add-security-review). ListeningSocket struct:
           (protocol, address, port, executable, unit, reach, state, zone)
         protocol  "tcp" (LISTEN) or "udp" (bound)
         reach     "local"    loopback only
                   "link"     link-local, or a docker*/virbr*/veth* bridge
                   "network"  any other address, including 0.0.0.0 and ::
         state     "exposed"  reach is network and the zone of the interface
                              lets the port in (service, port or target
                              ACCEPT), or firewalld is not running
                   "filtered" reach is network and no zone lets it in
                   ""         reach is local or link
         zone      the firewalld zone that decided state; empty otherwise
         unit      the systemd unit owning the process; empty for a process
                   started outside a unit (e.g. from a terminal) -->
    <method name="ListListening">
      <!-- polkit: org.lyraos.vega.firewall.read-admin (brokered, silent for
           the active local session, like ListServices) -->
      <arg name="sockets" type="a(ssqsssss)" direction="out"/>
    </method>
  </interface>
</node>
